# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# ---------- LLM ----------
# Any provider litellm supports. Pick one model line and the matching key.
#
#   Gemini      MODEL=gemini/gemini-2.0-flash
#   OpenAI      MODEL=gpt-4o-mini
#   Anthropic   MODEL=anthropic/claude-sonnet-4-5
#   Groq        MODEL=groq/llama-3.3-70b-versatile
#   Local       MODEL=ollama/llama3   + LLM_API_BASE=http://127.0.0.1:11434
MODEL=gemini/gemini-2.0-flash
LLM_API_KEY=your_key_here

# Only for OpenAI-compatible or local servers; leave unset otherwise.
# LLM_API_BASE=http://127.0.0.1:11434/v1

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---------- Service discovery ----------
# Point these at wherever each module is actually deployed.
RESEARCH_URL=http://127.0.0.1:8001
FACT_CHECKER_URL=http://127.0.0.1:8002
MARKETING_URL=http://127.0.0.1:8003
TRAVEL_URL=http://127.0.0.1:8004

DEPENDENCY_TIMEOUT_SECONDS=120
DEPENDENCY_CONNECT_TIMEOUT_SECONDS=5
DEPENDENCY_MAX_RETRIES=2

# ---------- Identity ----------
DEPLOYMENT_ID=local
ENVIRONMENT=development

# ---------- Observability ----------
# Spans are always built in-process and served from /telemetry/*.
# Export is optional: set an OTLP endpoint, or Langfuse keys, or neither.
OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=key=value,key2=value2
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

LOG_LEVEL=INFO
TRACE_BUFFER_SIZE=64

# ---------- Tools ----------
SEARCH_ENABLED=true
SEARCH_TIMEOUT_SECONDS=10

# ---------- Failure injection (for the testing platform) ----------
# normal | slow | error | timeout | tool_failure | dependency_failure
# Can also be set per request via the /run body.
FAILURE_MODE=normal
SLOW_MODE_DELAY_SECONDS=5
TIMEOUT_MODE_DELAY_SECONDS=125
